// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clerkId String @unique
  email   String @unique

  charts   Chart[]
  projects Project[]
  patterns Pattern[]
}

model Chart {
  id        String   @id @default(cuid()) // Using CUID for better indexing performance
  title     String
  createdAt DateTime @default(now())
  published Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gridWidth  Int    @default(5)
  gridHeight Int    @default(5)
  pixels     String

  tags      String[]
  Pattern   Pattern? @relation(fields: [patternId], references: [id])
  patternId String?
}

model Project {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  title       String    @db.VarChar(255)
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  status    ProjectStatus
  notes     String
  craft     String
  gauge     String
  pattern   Pattern?      @relation(fields: [patternId], references: [id])
  patternId String?

  images Image[]
  tags   String[]
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  FROGGED
  HIBERNATING
}

model Pattern {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  published  Boolean  @default(false)
  title      String   @db.VarChar(255)
  designer   User?    @relation(fields: [designerId], references: [id])
  designerId String?

  pdfUrl         String
  description    String
  craft          String
  category       String
  gauge          String
  sizes          String
  yarn           String
  yarnWeight     String
  needleHookSize String
  yardage        String
  price          String
  languages      String

  images  Image[]
  tags    String[]
  Project Project[]
  charts  Chart[]
}

model Image {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  url       String

  Pattern   Pattern? @relation(fields: [patternId], references: [id])
  patternId String?
  Project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}
